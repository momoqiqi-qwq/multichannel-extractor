{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      },
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "backgroundColor": "#0d1b2d",
        "center": true,
        "dragDropEnabled": true,
        "focus": true,
        "height": 900,
        "label": "main",
        "minHeight": 640,
        "minWidth": 980,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "theme": "Dark",
        "title": "解压台 · jieyatai-2 · 多通道项目解压与任务中心",
        "visible": true,
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png"
    ],
    "targets": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "identifier": "com.jieyatai.multichannel-extractor",
  "mainBinaryName": "JieYaTai",
  "productName": "解压台",
  "version": "2.0.0"
}
